import "./TaskManagerViewState"
import "../model/TaskManagerModel"

class TaskViewModel {
    let viewState: TaskManagerViewState = TaskManagerViewState()
    let model: TaskManagerModel = TaskManagerModel()

    func ensureLoaded() {
        if (self.viewState.initialized == false) {
            self.viewState.initialized = true
            self.viewState.tasks = self.model.fetchTasks()
            self.viewState.activity = "Loaded " + self.viewState.tasks.count + " tasks"
        }
    }

    func refresh() {
        self.viewState.tasks = self.model.fetchTasks()
        self.viewState.activity = "Loaded " + self.viewState.tasks.count + " tasks"
    }

    func getDemoToken() {
        let t = self.model.getDemoToken()
        self.viewState.token = t
        self.viewState.activity = "Demo token obtained"
    }

    func todoTasks(): Array<Task> {
        return self.model.todoTasks(self.viewState.tasks)
    }

    func inProgressTasks(): Array<Task> {
        return self.model.inProgressTasks(self.viewState.tasks)
    }

    func resolvedTasks(): Array<Task> {
        return self.model.resolvedTasks(self.viewState.tasks)
    }

    func save() {
        if (self.viewState.editingId != "") {
            self.model.updateTask(self.viewState.editingId, self.viewState.formTitle, self.viewState.formDesc, self.viewState.formStatus)
            self.viewState.activity = "Task updated"
        } else {
            self.model.createTask(self.viewState.formTitle, self.viewState.formDesc, self.viewState.formStatus)
            self.viewState.activity = "Task created"
        }
        self.viewState.editingId = ""
        self.viewState.formTitle = ""
        self.viewState.formDesc = ""
        self.viewState.formStatus = "todo"
        self.refresh()
    }

    func deleteTask(id: String) {
        self.viewState.tasks = self.viewState.tasks.filter { t in t.id != id }
        self.viewState.activity = "Task deleted"
        self.model.deleteTask(id)
    }

    func resolveTask(id: String) {
        let updated = []
        self.viewState.tasks.forEach { task in
            if (task.id == id) {
                task.status = "resolved"
            }
            updated.append(task)
        }
        self.viewState.tasks = updated
        self.viewState.activity = "Task resolved"
        self.model.resolveTask(id, self.viewState.tasks)
    }

    func startEdit(id: String) {
        self.viewState.tasks.forEach { task in
            if (task.id == id) {
                self.viewState.formTitle = task.title
                self.viewState.formDesc = task.description
                self.viewState.formStatus = task.status
                self.viewState.editingId = id
            }
        }
        self.viewState.activity = "Editing task " + id
    }

    func reset() {
        self.viewState.formTitle = ""
        self.viewState.formDesc = ""
        self.viewState.formStatus = "todo"
        self.viewState.editingId = ""
        self.viewState.activity = "Form reset"
    }

    func truncate60(s: String): String {
        if (s.count <= 60) { return s }
        let result = s
        let excess = s.count - 60
        let i = 0
        while (i < excess) {
            result = result.dropLast()
            i = i + 1
        }
        return result + "..."
    }

    func summarize() {
        self.viewState.activity = "Requesting summary..."
        let text = self.model.summarizeTasks(self.viewState.tasks)
        self.viewState.summary = text
        self.viewState.activity = self.truncate60(text)
    }

    func highlight() {
        self.viewState.activity = "Requesting highlights..."
        let text = self.model.highlightTasks(self.viewState.tasks)
        self.viewState.highlights = text
        self.viewState.activity = self.truncate60(text)
    }
}
