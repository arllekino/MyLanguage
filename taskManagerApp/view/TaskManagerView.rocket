import "libs/UI"
import "./PipelineBoardView"
import "./SidebarView"
import "../presentation/TaskViewModel"

struct TaskManagerView : View {
    tracked let vm: TaskViewModel = TaskViewModel()

    let view: any View {
        self.vm.ensureLoaded()
        let primaryColor = Color(0.07, 0.08, 0.12)
        let secondaryColor = Color(0.42, 0.47, 0.57)

        return VBox(0.0, HAlign.start) {
            return [
                HBox(20.0, VAlign.center) {
                    return [
                        VBox(3.0, HAlign.start) {
                            return [
                                Text("TASK TRACKER", 9.0, secondaryColor),
                                Text("Pipeline board", 21.0, primaryColor)
                            ]
                        },
                        Button("Refresh", Color(0.35, 0.38, 0.45)) { self.vm.refresh() },
                        Button("Demo Token", Color.blue) { self.vm.getDemoToken() }
                    ]
                }
                .padding(20.0)
                .background(Color.white, 1.0),
                HBox(16.0, VAlign.top) {
                    return [
                        PipelineBoardView(self.vm),
                        SidebarView(self.vm)
                    ]
                }
                .padding(16.0)
            ]
        }
    }
}
