import "libs/UI"
import "../presentation/TaskViewModel"

struct StatusButtonView : View {
    let label: String
    let value: String
    let vm: TaskViewModel

    let view: any View {
        if (self.vm.viewState.formStatus == self.value) {
            return Button(self.label, Color.blue) { self.vm.viewState.formStatus = self.value }
        }
        return Button(self.label, Color(0.28, 0.28, 0.33)) { self.vm.viewState.formStatus = self.value }
    }

    init(label: String, value: String, vm: TaskViewModel) {
        self.label = label
        self.value = value
        self.vm = vm
    }
}

struct FormSectionView : View {
    let vm: TaskViewModel

    let view: any View {
        let items = []
        if (self.vm.viewState.editingId != "") {
            items.append(Text("Edit Task " + self.vm.viewState.editingId, 13.0, Color.orange))
        }
        if (self.vm.viewState.editingId == "") {
            items.append(Text("New Task", 13.0, Color.white))
        }
        items.append(TextField("titleField", self.vm.viewState.formTitle, 320.0) {
            self.vm.viewState.formTitle = it
        })
        items.append(TextField("descField", self.vm.viewState.formDesc, 320.0) {
            self.vm.viewState.formDesc = it
        })
        items.append(HBox(6.0, VAlign.center) {
            return [
                StatusButtonView("Todo", "todo", self.vm),
                StatusButtonView("In Progress", "in_progress", self.vm),
                StatusButtonView("Resolved", "resolved", self.vm)
            ]
        })
        items.append(HBox(8.0, VAlign.center) {
            return [
                Button("Save", Color.blue) { self.vm.save() },
                Button("Reset", Color(0.3, 0.3, 0.36)) { self.vm.reset() }
            ]
        })
        return VBox(8.0, HAlign.start) {
            return items
        }.padding(12.0).background(Color(0.14, 0.14, 0.17), 1.0).cornerRadius(8.0)
    }

    init(vm: TaskViewModel) {
        self.vm = vm
    }
}
