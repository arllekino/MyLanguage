import "libs/UI"
import "../presentation/TaskViewModel"

struct StatusButtonView : View {
    let label: String
    let value: String
    let vm: TaskViewModel

    let view: any View {
        if (self.vm.viewState.formStatus == self.value) {
            return Button(self.label, Color.blue) { self.vm.viewState.formStatus = self.value }
        }
        return Button(self.label, Color(0.38, 0.42, 0.52)) { self.vm.viewState.formStatus = self.value }
    }

    init(label: String, value: String, vm: TaskViewModel) {
        self.label = label
        self.value = value
        self.vm = vm
    }
}

struct FormSectionView : View {
    let vm: TaskViewModel

    let view: any View {
        let items = []
        if (self.vm.viewState.editingId != "") {
            items.append(Text("Edit Task  #" + self.vm.viewState.editingId, 14.0, Color(0.07, 0.08, 0.12)))
        }
        if (self.vm.viewState.editingId == "") {
            items.append(Text("New Task", 14.0, Color(0.07, 0.08, 0.12)))
        }
        items.append(Text("Title", 11.0, Color(0.42, 0.47, 0.57)))
        items.append(TextField("titleField", self.vm.viewState.formTitle, 250.0) {
            self.vm.viewState.formTitle = it
        })
        items.append(Text("Description", 11.0, Color(0.42, 0.47, 0.57)))
        items.append(TextField("descField", self.vm.viewState.formDesc, 250.0) {
            self.vm.viewState.formDesc = it
        })
        items.append(Text("Status", 11.0, Color(0.42, 0.47, 0.57)))
        items.append(HBox(6.0, VAlign.center) {
            return [
                StatusButtonView("Todo", "todo", self.vm),
                StatusButtonView("In Prog", "in_progress", self.vm),
                StatusButtonView("Done", "resolved", self.vm)
            ]
        })
        items.append(HBox(8.0, VAlign.center) {
            return [
                Button("Save", Color.blue) { self.vm.save() },
                Button("Cancel", Color(0.38, 0.42, 0.52)) { self.vm.reset() }
            ]
        })
        return VBox(8.0, HAlign.start) {
            return items
        }.padding(16.0).background(Color.white, 1.0).cornerRadius(8.0)
    }

    init(vm: TaskViewModel) {
        self.vm = vm
    }
}
