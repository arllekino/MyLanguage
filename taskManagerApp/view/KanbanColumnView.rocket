import "libs/UI"
import "./TaskCardView"
import "../model/entity/Task"
import "../presentation/TaskViewModel"

struct KanbanColumnView : View {
    let colTitle: String
    let tasks: Array<Task>
    let vm: TaskViewModel

    let view: any View {
        let items = [HBox(8.0, VAlign.center) {
            return [
                Text(self.colTitle, 13.0, Color.white),
                Text("  " + self.tasks.count, 12.0, Color(0.5, 0.5, 0.58))
            ]
        }]
        if (self.tasks.count == 0) {
            items.append(Text("No cards in this lane", 11.0, Color(0.4, 0.4, 0.48)))
        }
        self.tasks.forEach { task in
            items.append(TaskCardView(task, self.vm))
        }
        return VBox(8.0, HAlign.start) {
            return items
        }.padding(12.0).background(Color(0.14, 0.14, 0.17), 1.0).cornerRadius(10.0)
    }

    init(colTitle: String, tasks: Array<Task>, vm: TaskViewModel) {
        self.colTitle = colTitle
        self.tasks = tasks
        self.vm = vm
    }
}
