import "libs/UI"
import "./FormSectionView"
import "../presentation/TaskViewModel"

struct SidebarView : View {
    let vm: TaskViewModel

    func tokenSection(): any View {
        return VBox(8.0, HAlign.start) {
            return [
                Text("API Token", 12.0, Color(0.55, 0.55, 0.62)),
                TextField("tokenField", self.vm.viewState.token, 320.0) {
                    self.vm.viewState.token = it
                },
                HBox(8.0, VAlign.center) {
                    return [
                        Button("Demo Token", Color.purple) { self.vm.getDemoToken() },
                        Button("Refresh", Color.blue) { self.vm.refresh() }
                    ]
                }
            ]
        }.padding(12.0).background(Color(0.14, 0.14, 0.17), 1.0).cornerRadius(8.0)
    }

    func aiSection(): any View {
        return VBox(8.0, HAlign.start) {
            return [
                Text("AI Actions", 13.0, Color.white),
                HBox(8.0, VAlign.center) {
                    return [
                        Button("Summarize", Color.teal) { self.vm.refresh() },
                        Button("Highlight", Color.purple) { self.vm.refresh() }
                    ]
                },
                Text(self.vm.viewState.summary, 11.0, Color(0.55, 0.55, 0.65)),
                Text(self.vm.viewState.highlights, 11.0, Color(0.55, 0.55, 0.65))
            ]
        }.padding(12.0).background(Color(0.14, 0.14, 0.17), 1.0).cornerRadius(8.0)
    }

    func activitySection(): any View {
        return VBox(4.0, HAlign.start) {
            return [
                Text("Activity", 11.0, Color(0.45, 0.45, 0.52)),
                Text(self.vm.viewState.activity, 12.0, Color.green)
            ]
        }.padding(10.0).background(Color(0.12, 0.12, 0.15), 1.0).cornerRadius(6.0)
    }

    let view: any View {
        return VBox(12.0, HAlign.start) {
            return [
                self.tokenSection(),
                FormSectionView(self.vm),
                self.aiSection(),
                self.activitySection()
            ]
        }
    }

    init(vm: TaskViewModel) {
        self.vm = vm
    }
}
