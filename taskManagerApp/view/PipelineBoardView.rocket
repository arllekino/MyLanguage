import "libs/UI"
import "./KanbanColumnView"
import "../presentation/TaskViewModel"

struct StatCardView : View {
    let label: String
    let cnt: Int
    let accent: Color

    let view: any View {
        return VBox(4.0, HAlign.start) {
            return [
                Text("" + self.cnt, 26.0, self.accent),
                Text(self.label, 11.0, Color(0.42, 0.47, 0.57))
            ]
        }.padding(16.0).background(Color.white, 1.0).cornerRadius(8.0)
    }

    init(label: String, cnt: Int, accent: Color) {
        self.label = label
        self.cnt = cnt
        self.accent = accent
    }
}

struct PipelineBoardView : View {
    let vm: TaskViewModel

    let view: any View {
        let todo = self.vm.todoTasks()
        let inProg = self.vm.inProgressTasks()
        let done = self.vm.resolvedTasks()
        let total = self.vm.viewState.tasks.count

        return VBox(14.0, HAlign.start) {
            return [
                HBox(10.0, VAlign.top) {
                    return [
                        StatCardView("Todo", todo.count, Color(0.42, 0.47, 0.57)),
                        StatCardView("In Progress", inProg.count, Color.blue),
                        StatCardView("Resolved", done.count, Color.green),
                        StatCardView("Total", total, Color(0.55, 0.28, 0.88))
                    ]
                },
                VBox(3.0, HAlign.start) {
                    return [
                        Text("Pipeline", 14.0, Color(0.07, 0.08, 0.12)),
                        Text("Cards move left to right as status changes.", 11.0, Color(0.42, 0.47, 0.57))
                    ]
                },
                HBox(10.0, VAlign.top) {
                    return [
                        KanbanColumnView("todo", todo, self.vm),
                        KanbanColumnView("in_progress", inProg, self.vm),
                        KanbanColumnView("resolved", done, self.vm)
                    ]
                }
            ]
        }
    }

    init(vm: TaskViewModel) {
        self.vm = vm
    }
}
