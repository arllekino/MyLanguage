import "libs/Net"

async func fetchTodo() {
    let res = Http.get("https://jsonplaceholder.typicode.com/todos/1")
    if (res.isOk) {
        let parsed = Json.parse(res.value)
        print("title: " + parsed.title)
    } else {
        print("error: " + res.error)
    }
    print("fetchTodo done")
}

async func doMath() {
    let x = 10
    let y = 20
    print("math result: " + (x + y))
    print("doMath done")
}

print("start")

Async {
    await doMath()
}

print("end")
await fetchTodo()
