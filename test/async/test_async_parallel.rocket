import "libs/Net"

async func fetchAndPrint(url: String, label: String) {
    let res = Http.get(url)
    if (res.isOk) {
        let parsed = Json.parse(res.value)
        print(label + ": " + parsed.title)
    }
}

print("launching 3 parallel requests...")

Async {
    await fetchAndPrint("https://jsonplaceholder.typicode.com/todos/1", "todo-1")
}

Async {
    await fetchAndPrint("https://jsonplaceholder.typicode.com/todos/2", "todo-2")
}

Async {
    await fetchAndPrint("https://jsonplaceholder.typicode.com/todos/3", "todo-3")
}

print("all launched, main thread continues")
await fetchAndPrint("https://jsonplaceholder.typicode.com/todos/1", "todo-1")
