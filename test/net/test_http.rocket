import "libs/Net"

let res = Http.get("https://jsonplaceholder.typicode.com/todos/1")
if (res.isOk) {
    let todo = Json.parse(res.value)
    print("Title: " + todo.title)
    print("Done:  " + todo.completed)
} else {
    print("Error: " + res.error)
}

let body = Json.stringify(Json.parse("{\"title\":\"New task\",\"completed\":false,\"userId\":1}"))
let postRes = Http.post("https://jsonplaceholder.typicode.com/todos", body)
if (postRes.isOk) {
    let created = Json.parse(postRes.value)
    print("Created id: " + created.id)
} else {
    print("POST error: " + postRes.error)
}

let badRes = Http.get("https://this-domain-does-not-exist-xyz.rocket")
if (badRes.isOk == false) {
    print("Got expected error for bad URL")
}
