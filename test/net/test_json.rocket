import "libs/Net"

let json = "{\"name\":\"Alice\",\"age\":30,\"active\":true}"
let obj = Json.parse(json)
print(obj.name)    // Alice
print(obj.age)     // 30
print(obj.active)  // true

let json2 = "{\"user\":{\"id\":1,\"tags\":[\"admin\",\"dev\"]}}"
let data = Json.parse(json2)
print(data.user.id)         // 1
print(data.user.tags[0])    // admin
print(data.user.tags[1])    // dev

// JSON stringify
let encoded = Json.stringify(obj)
print(encoded)

// Result.ok and Result.error
let r1 = Result.ok("success!")
print(r1.isOk)   // true
print(r1.value)  // success!

let r2 = Result.error("something went wrong")
print(r2.isOk)   // false
print(r2.error)  // something went wrong

// if let with Result
if let v = (r1.value) {
    print("Got: " + v)
}
