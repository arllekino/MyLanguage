import "libs/UI"

class ViewModel {
    trackable let state: String = ""

    func setState() {
        self.state = "New State"
    }
}

struct MyApp: View {
    tracked let vm: ViewModel = ViewModel()

    let view: any View {
        return VBox(20.0, HAlign.center) {
            return [
                Text(self.vm.state, 24.0, Color.white),
                Rect(300.0, 60.0, Color.red),
                Button("Set State", Color.red) {
                    self.vm.setState()
                },
                HBox(10.0, VAlign.center) {
                    return [
                        Rect(100.0, 100.0, Color.green),
                        Rect(100.0, 100.0, Color.blue),
                        Rect(100.0, 100.0, Color.orange)
                    ]
                },
                Rect(300.0, 60.0, Color.teal)
            ]
        }
    }
}

let app = App()

app.run("Rocket SwiftUI", 800, 600) {
    return MyApp()
}
