import UI

struct MyApp: View {
    let body: any View {
        return VBox(20.0) {
            return [
                Rect(300.0, 60.0, Color.red),
                HBox(10.0) {
                    return [
                        Rect(100.0, 100.0, Color.green),
                        Rect(100.0, 100.0, Color.blue),
                        Rect(100.0, 100.0, Color.orange)
                    ]
                },
                Rect(300.0, 60.0, Color.teal)
            ]
        }
    }
}

let app = App()

app.run("Rocket SwiftUI") {
    return MyApp()
}
