    HBox(24.0, VAlign.center) {
        [
            VBox(8.0, HAlign.start) {
                [
                    Text("Fix critical bug", 18.0, Color.white),
                    Text("Priority: high",   14.0, Color.gray),
                    HBox(8.0, VAlign.center) {
                        [
                            Button("Resolve", Color.green) { },
                            Button("Delete",  Color.red)   { }
                        ]
                    }
                ]
            }
