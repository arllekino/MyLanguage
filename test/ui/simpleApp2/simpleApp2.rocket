import UI

class ViewModel {
    trackable let state: String = ""

    func setState() {
        self.state = "New State"
    }
}

struct MyApp: View {
    tracked let vm: ViewModel = ViewModel()

    let view: any View {
        return VBox(20.0) {
            return [
                Text(self.vm.state, 24.0, Color.white),
                Button("Clear", Color.red) {
                    self.vm.setState()
                }
            ]
        }
    }
}

let app = App()

app.run("Rocket SwiftUI") {
    return MyApp()
}
